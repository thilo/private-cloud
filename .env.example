###############################################################################
# Personal Cloud — configuration
#
# Copy to .env (scripts/init.sh does this for you and fills in the secrets).
# Compose reads this file automatically for ${VAR} substitution.
#
# backup.sh / restore.sh / prod-setup.sh / verify.sh source this file as shell,
# so a value containing a space must be quoted — Compose strips the quotes.
#
#   LOCAL TEST  -> *.127.0.0.1.nip.io domains, ports 8080/8443, CADDY_TLS=internal
#   PRODUCTION  -> use .env.production.example instead (see README "Production
#                  deployment"): your real domains, ports 80/443, CADDY_TLS=email
###############################################################################

## --- Ingress / TLS -------------------------------------------------------- ##
# Host ports Caddy publishes. Use 80/443 in production.
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS mode for Caddy:
#   internal          -> Caddy's own CA (self-signed), for local testing
#   you@example.com   -> automatic Let's Encrypt for the domains below
CADDY_TLS=internal

# Public hostnames for each app.
# Local testing uses *.127.0.0.1.nip.io — a public wildcard DNS that resolves
# to 127.0.0.1, so curl, the Bitwarden/Immich CLIs, and your browser all reach
# the local Caddy without editing /etc/hosts. In production, replace with your
# real domains (e.g. cloud.example.com).
SEAFILE_DOMAIN=seafile.127.0.0.1.nip.io
IMMICH_DOMAIN=immich.127.0.0.1.nip.io
VAULTWARDEN_DOMAIN=vault.127.0.0.1.nip.io

# Full external origin of Vaultwarden (scheme + host [+ port]); required for
# WebAuthn / passkey 2FA. Must match how you reach it in the browser.
VAULTWARDEN_URL=https://vault.127.0.0.1.nip.io:8443

## --- General -------------------------------------------------------------- ##
TZ=Europe/Berlin
# Fixed subnet for the proxy network keeps its address range predictable.
PROXY_SUBNET=172.28.0.0/24

## --- Storage Box (cheap bulk blob storage over CIFS/SMB) ------------------ ##
# Big, cold blobs — Immich originals and Seafile blocks — live on a CIFS/SMB share
# instead of the server's small/expensive local disk. Databases and hot caches
# always stay local. See README "Storage layout".
#
#   LOCAL TEST -> a Samba container simulates the box. The COMPOSE_FILE line below
#                 pulls that simulator into every `docker compose` invocation, and
#                 SB_HOST points at its fixed IP (must be inside PROXY_SUBNET).
#   PRODUCTION -> don't edit this file; copy .env.production.example instead (it has
#                 no COMPOSE_FILE line, so no simulator) and follow README
#                 "Production deployment" — scripts/prod.env adds the overlay.
COMPOSE_FILE=docker-compose.yml:docker-compose.storagebox-sim.yml
SB_HOST=172.28.0.250
SB_SHARE=backup
SB_USER=sbuser
SB_PASSWORD=CHANGEME
# Hetzner Storage Boxes speak SMB 3; drop to 2.1 only if a mount negotiation fails.
# Note: the mounts use `seal` (SMB3 transport encryption), which REQUIRES >= 3.0 —
# dropping to 2.1 disables sealing and the mount will fail. The simulator's Samba
# is configured with `smb encrypt = required`, so the local run proves that path.
SB_SMB_VERS=3.0

## --- Image versions (pin for reproducibility) ----------------------------- ##
# Pinned (was `release`, a floating tag): server + machine-learning share this
# version. This is the Noodle Gallery fork's version, NOT Immich's — each fork
# release is based on an upstream Immich release. Bump deliberately; read the
# fork's release notes first, and expect a geodata re-import (see the
# immich-server notes in docker-compose.yml — that import is what sizes its
# mem_limit).
IMMICH_VERSION=v5.3.0
CADDY_IMAGE=caddy:2-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.1-alpine
# Both redis tiers (immich job broker, seafile cache) run this one image.
VALKEY_IMAGE=valkey/valkey:8-alpine
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0.25
# Real-time push sidecar (websocket). Keep the major version in lockstep with
# SEAFILE_IMAGE — bump both together. Released independently, so the patch
# numbers do not track.
NOTIFICATION_SERVER_IMAGE=seafileltd/notification-server:13.0.21
SEAFILE_DB_IMAGE=mariadb:10.11
# Immich's vector-enabled Postgres, pinned by digest (do not float this one).
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

## --- Immich --------------------------------------------------------------- ##
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGEME
IMMICH_REDIS_PASSWORD=CHANGEME

## --- Seafile (reliable file sync + client-side encrypted libraries) -------- ##
SEAFILE_DB_ROOT_PASSWORD=CHANGEME
SEAFILE_DB_PASSWORD=CHANGEME
SEAFILE_REDIS_PASSWORD=CHANGEME
# Random 32+ char secret signing Seafile's internal JWTs (required by v12+).
SEAFILE_JWT_KEY=CHANGEME

## --- Initial admin accounts ----------------------------------------------- ##
# The first Seafile admin credentials are SETUP-ONLY secrets and live in
# a SEPARATE file (.env.setup) that Compose does NOT load at runtime — see
# .env.setup.example. scripts/init.sh .

## --- Email (SMTP) --------------------------------------------------------- ##
# Outgoing mail is OPTIONAL and OFF by default: an empty SMTP_HOST disables it,
# and every app runs fine without it (no invite / password-reset / notification
# mail). To enable, set SMTP_HOST plus the credentials below.
#
# One credential, wired up two different ways, because the images differ:
#   Vaultwarden — reads these SMTP_* vars directly (docker-compose.yml).
#   Seafile     — takes no env vars for mail; scripts/harden-seafile.sh reads the
#                 same values and writes EMAIL_* into conf/seahub_settings.py.
#   Immich      — not env-driven at all; configure SMTP in its admin UI
#                 (Administration -> Settings -> Notifications).
# See README "Email (SMTP)".
SMTP_HOST=
SMTP_PORT=587
# Vaultwarden security mode: off | starttls (port 587) | force_tls (port 465)
SMTP_SECURITY=starttls
# The From address, and usually the same value as SMTP_USERNAME.
SMTP_FROM=notifications@example.com
SMTP_FROM_NAME="Private Cloud"
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=CHANGEME

## --- Vaultwarden ---------------------------------------------------------- ##
# Empty = admin panel disabled (recommended). To enable, set an argon2 hash:
#   docker run --rm vaultwarden/server:1.36.0-alpine /vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=
# Runtime default: closed. The setup overlay (docker-compose.setup.yml) opens
# signups for the FIRST `up` so you can register your account; the next plain
# `docker compose up -d` omits the overlay and closes them again. See README
# "First Vaultwarden account".
VAULTWARDEN_SIGNUPS_ALLOWED=false
