###############################################################################
# Personal Cloud — configuration
#
# Copy to .env (scripts/init.sh does this for you and fills in the secrets).
# Compose reads this file automatically for ${VAR} substitution.
#
#   LOCAL TEST  -> *.localhost domains, ports 8080/8443, CADDY_TLS=internal
#   PRODUCTION  -> your real domains, ports 80/443, CADDY_TLS=you@example.com
###############################################################################

## --- Ingress / TLS -------------------------------------------------------- ##
# Host ports Caddy publishes. Use 80/443 in production.
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS mode for Caddy:
#   internal          -> Caddy's own CA (self-signed), for local testing
#   you@example.com   -> automatic Let's Encrypt for the domains below
CADDY_TLS=internal

# Public hostnames for each app.
# Local testing uses *.127.0.0.1.nip.io — a public wildcard DNS that resolves
# to 127.0.0.1, so curl, the Bitwarden/Immich CLIs, and your browser all reach
# the local Caddy without editing /etc/hosts. In production, replace with your
# real domains (e.g. cloud.example.com).
SEAFILE_DOMAIN=seafile.127.0.0.1.nip.io
IMMICH_DOMAIN=immich.127.0.0.1.nip.io
VAULTWARDEN_DOMAIN=vault.127.0.0.1.nip.io

# Full external origin of Vaultwarden (scheme + host [+ port]); required for
# WebAuthn / passkey 2FA. Must match how you reach it in the browser.
VAULTWARDEN_URL=https://vault.127.0.0.1.nip.io:8443

## --- General -------------------------------------------------------------- ##
TZ=Europe/Berlin
# Fixed subnet for the proxy network keeps its address range predictable.
PROXY_SUBNET=172.28.0.0/24

## --- Image versions (pin for reproducibility) ----------------------------- ##
IMMICH_VERSION=release
CADDY_IMAGE=caddy:2-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.36.0-alpine
REDIS_IMAGE=redis:7-alpine
VALKEY_IMAGE=valkey/valkey:8-alpine
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0-latest
SEAFILE_DB_IMAGE=mariadb:10.11
# Immich's vector-enabled Postgres, pinned by digest (do not float this one).
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

## --- Immich --------------------------------------------------------------- ##
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGEME
IMMICH_REDIS_PASSWORD=CHANGEME
# First admin account, created by scripts/bootstrap.sh (used by the iOS app).
IMMICH_ADMIN_EMAIL=admin@example.com
IMMICH_ADMIN_NAME=Admin
IMMICH_ADMIN_PASSWORD=CHANGEME

## --- Seafile (reliable file sync + client-side encrypted libraries) -------- ##
SEAFILE_DB_ROOT_PASSWORD=CHANGEME
SEAFILE_DB_PASSWORD=CHANGEME
SEAFILE_REDIS_PASSWORD=CHANGEME
# Random 32+ char secret signing Seafile's internal JWTs (required by v12+).
SEAFILE_JWT_KEY=CHANGEME
# First admin account, created on Seafile's first start (used by the apps).
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=CHANGEME

## --- Vaultwarden ---------------------------------------------------------- ##
# Empty = admin panel disabled (recommended). To enable, set an argon2 hash:
#   docker run --rm vaultwarden/server:1.36.0-alpine /vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=
# Keep signups closed once your accounts exist. init.sh / verify.sh flip this
# temporarily only for the automated test.
VAULTWARDEN_SIGNUPS_ALLOWED=false
