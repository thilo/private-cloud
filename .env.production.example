###############################################################################
# Personal Cloud — PRODUCTION configuration template
#
# Generate the real .env.production (with strong random secrets) from this file:
#   ENV_FILE=.env.production EXAMPLE=.env.production.example GEN_SB_PASSWORD=0 \
#     ./scripts/init.sh
# then fill in SB_PASSWORD (your Storage Box password) and review the values below.
#
# Day-to-day, source the production switches once per shell so plain
# `docker compose ...`, bootstrap.sh and verify.sh all target production:
#   source scripts/prod.env
###############################################################################

## --- Ingress / TLS -------------------------------------------------------- ##
# Real ports in production. Forward TCP 80 + 443 from the firewall to the host.
HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt: set to the contact email to switch Caddy from its internal CA to
# automatic public certificates. Requires the domains below to resolve to this
# host and ports 80/443 to be reachable. Use `internal` to deploy before DNS.
CADDY_TLS=you@example.com

# Public hostnames for each app (must have A records pointing at this server).
SEAFILE_DOMAIN=seafile.example.com
IMMICH_DOMAIN=immich.example.com
VAULTWARDEN_DOMAIN=vault.example.com

# Full external origin of Vaultwarden (scheme + host); required for WebAuthn /
# passkey 2FA. No port suffix in production (443 is implicit).
VAULTWARDEN_URL=https://vault.example.com

## --- General -------------------------------------------------------------- ##
TZ=Europe/Berlin
# Fixed subnet for the proxy network keeps its address range predictable.
PROXY_SUBNET=172.28.0.0/24

## --- Storage layout ------------------------------------------------------- ##
# DATA_ROOT is a directory on the ATTACHED block volume. The production overlay
# (docker-compose.production.yml) bind-mounts every latency-sensitive volume
# under here: all databases, Vaultwarden, Seafile conf/metadata, Immich hot
# derivatives, Caddy's TLS material, the ML model cache. Logs/temp stay on the
# host root disk; bulk blobs stay on the Storage Box (below).
DATA_ROOT=/mnt/HC_Volume_106062366/private-cloud

## --- Storage Box (cheap bulk blob storage over CIFS/SMB) ------------------ ##
# The real Hetzner Storage Box. The host needs cifs-utils installed, and the
# immich/ and seafile/ subfolders must exist on the share before first `up`.
SB_HOST=u616619.your-storagebox.de
SB_SHARE=backup
SB_USER=u616619
SB_PASSWORD=CHANGEME
# Hetzner Storage Boxes speak SMB 3; drop to 2.1 only if a mount negotiation fails.
SB_SMB_VERS=3.0

## --- Image versions (pin for reproducibility) ----------------------------- ##
IMMICH_VERSION=release
CADDY_IMAGE=caddy:2-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.36.0-alpine
REDIS_IMAGE=redis:7-alpine
VALKEY_IMAGE=valkey/valkey:8-alpine
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0-latest
SEAFILE_DB_IMAGE=mariadb:10.11
# Immich's vector-enabled Postgres, pinned by digest (do not float this one).
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

## --- Immich --------------------------------------------------------------- ##
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGEME
IMMICH_REDIS_PASSWORD=CHANGEME
# First admin account, created by scripts/bootstrap.sh (used by the iOS app).
IMMICH_ADMIN_EMAIL=you@example.com
IMMICH_ADMIN_NAME=Admin
IMMICH_ADMIN_PASSWORD=CHANGEME

## --- Seafile (reliable file sync + client-side encrypted libraries) -------- ##
SEAFILE_DB_ROOT_PASSWORD=CHANGEME
SEAFILE_DB_PASSWORD=CHANGEME
SEAFILE_REDIS_PASSWORD=CHANGEME
# Random 32+ char secret signing Seafile's internal JWTs (required by v12+).
SEAFILE_JWT_KEY=CHANGEME
# First admin account, created on Seafile's first start (used by the apps).
SEAFILE_ADMIN_EMAIL=you@example.com
SEAFILE_ADMIN_PASSWORD=CHANGEME

## --- Vaultwarden ---------------------------------------------------------- ##
# Empty = admin panel disabled (recommended). To enable, set an argon2 hash:
#   docker run --rm vaultwarden/server:1.36.0-alpine /vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=
# Keep signups closed once your accounts exist. verify.sh flips this temporarily
# only for the automated test, then restores false.
VAULTWARDEN_SIGNUPS_ALLOWED=false
