###############################################################################
# Personal Cloud — PRODUCTION configuration template
#
# Generate the real .env.production (runtime secrets) AND .env.production.setup
# (the initial admin-account secrets) — both with strong random values — from the
# templates in one go:
#   ENV_FILE=.env.production EXAMPLE=.env.production.example GEN_SB_PASSWORD=0 \
#     ./scripts/init.sh
# then fill in SB_PASSWORD (your Storage Box password) and review the values below.
#
# Day-to-day, source the production switches once per shell so plain
# `docker compose ...`, bootstrap.sh and verify.sh all target production:
#   source scripts/prod.env
#
# backup.sh / restore.sh / prod-setup.sh / verify.sh source this file as shell,
# so a value containing a space must be quoted — Compose strips the quotes.
###############################################################################

## --- Ingress / TLS -------------------------------------------------------- ##
# Real ports in production. Forward TCP 80 + 443 from the firewall to the host.
HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt: set to the contact email to switch Caddy from its internal CA to
# automatic public certificates. Requires the domains below to resolve to this
# host and ports 80/443 to be reachable. Use `internal` to deploy before DNS.
CADDY_TLS=you@example.com

# Public hostnames for each app (must have A records pointing at this server).
SEAFILE_DOMAIN=seafile.example.com
IMMICH_DOMAIN=immich.example.com
VAULTWARDEN_DOMAIN=vault.example.com

# Full external origin of Vaultwarden (scheme + host); required for WebAuthn /
# passkey 2FA. No port suffix in production (443 is implicit).
VAULTWARDEN_URL=https://vault.example.com

## --- General -------------------------------------------------------------- ##
TZ=Europe/Berlin
# Fixed subnet for the proxy network keeps its address range predictable.
PROXY_SUBNET=172.28.0.0/24

## --- Storage layout ------------------------------------------------------- ##
# DATA_ROOT is a directory on the ATTACHED block volume. The production overlay
# (docker-compose.production.yml) bind-mounts every latency-sensitive volume
# under here: all databases, Vaultwarden, Seafile conf/metadata, Immich hot
# derivatives, Caddy's TLS material, the ML model cache. Logs/temp stay on the
# host root disk; bulk blobs stay on the Storage Box (below).
DATA_ROOT=/mnt/HC_Volume_106062366/private-cloud

## --- Storage Box (cheap bulk blob storage over CIFS/SMB) ------------------ ##
# The real Hetzner Storage Box. The host needs cifs-utils installed, and the
# immich/ and seafile/ subfolders must exist on the share before first `up`.
SB_HOST=u616619.your-storagebox.de
SB_SHARE=backup
SB_USER=u616619
SB_PASSWORD=CHANGEME
# Hetzner Storage Boxes speak SMB 3; drop to 2.1 only if a mount negotiation fails.
# Note: the mounts use `seal` (SMB3 transport encryption), which REQUIRES >= 3.0 —
# dropping to 2.1 disables sealing and the mount will fail.
SB_SMB_VERS=3.0

## --- Docker engine (host, not a container) -------------------------------- ##
# Engine major line this host tracks. prod-setup.sh pins docker-ce to it and
# lets unattended-upgrades apply that line's patch releases, so security fixes
# land on their own but a new major never does.
# pc-docker-major-check.timer mails when a higher major exists: upgrade in a
# watched window, then raise both values here and re-run prod-setup.sh.
DOCKER_MAJOR=29
# containerd.io versions independently of the engine, and docker-ce depends on
# it with an open `>=`, so without its own pin a newer containerd line could
# land under the pinned engine. Check `apt-cache show docker-ce` before raising.
CONTAINERD_MAJOR=2

## --- Image versions (pin for reproducibility) ----------------------------- ##
# Pinned (was `release`, a floating tag): server + machine-learning share this
# version. This is the Noodle Gallery fork's version, NOT Immich's — each fork
# release is based on an upstream Immich release. Bump deliberately; read the
# fork's release notes first, and expect a geodata re-import (see the
# immich-server notes in docker-compose.yml — that import is what sizes its
# mem_limit).
IMMICH_VERSION=v5.3.0
CADDY_IMAGE=caddy:2.11.4-alpine
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.1-alpine
# Both redis tiers (immich job broker, seafile cache) run this one image.
VALKEY_IMAGE=valkey/valkey:8-alpine
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0.25
# Real-time push sidecar (websocket). Keep the major version in lockstep with
# SEAFILE_IMAGE — bump both together. Released independently, so the patch
# numbers do not track.
NOTIFICATION_SERVER_IMAGE=seafileltd/notification-server:13.0.21
SEAFILE_DB_IMAGE=mariadb:10.11
# Immich's vector-enabled Postgres, pinned by digest (do not float this one).
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

## --- Immich --------------------------------------------------------------- ##
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGEME
IMMICH_REDIS_PASSWORD=CHANGEME

## --- Seafile (reliable file sync + client-side encrypted libraries) -------- ##
SEAFILE_DB_ROOT_PASSWORD=CHANGEME
SEAFILE_DB_PASSWORD=CHANGEME
SEAFILE_REDIS_PASSWORD=CHANGEME
# Random 32+ char secret signing Seafile's internal JWTs (required by v12+).
SEAFILE_JWT_KEY=CHANGEME

## --- Initial admin accounts ----------------------------------------------- ##
# The first Immich + Seafile admin credentials are SETUP-ONLY secrets and live in
# a SEPARATE file (.env.production.setup) that Compose does NOT load at runtime —
# see .env.setup.example. The init.sh invocation below fills both files in one go.

## --- Email (SMTP) --------------------------------------------------------- ##
# Outgoing mail is OPTIONAL and OFF by default: an empty SMTP_HOST disables it,
# and every app runs fine without it (no invite / password-reset / notification
# mail). To enable, set SMTP_HOST plus the credentials below.
#
# One credential, wired up two different ways, because the images differ:
#   Vaultwarden — reads these SMTP_* vars directly (docker-compose.yml).
#   Seafile     — takes no env vars for mail; scripts/harden-seafile.sh reads the
#                 same values and writes EMAIL_* into conf/seahub_settings.py.
#   Immich      — not env-driven at all; configure SMTP in its admin UI
#                 (Administration -> Settings -> Notifications).
# See README "Email (SMTP)". For Gmail / Google Workspace use an app password
# (Google Account -> Security -> App passwords), never the account password.
SMTP_HOST=
SMTP_PORT=587
# Vaultwarden security mode: off | starttls (port 587) | force_tls (port 465)
SMTP_SECURITY=starttls
# The From address, and usually the same value as SMTP_USERNAME.
SMTP_FROM=notifications@example.com
SMTP_FROM_NAME="Private Cloud"
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=CHANGEME
# Where to mail a failed pc-backup / pc-restore-check run. Empty (or an empty
# SMTP_HOST) disables those alerts; nothing else changes.
ALERT_EMAIL=

## --- Vaultwarden ---------------------------------------------------------- ##
# Empty = admin panel disabled (recommended). To enable, set an argon2 hash:
#   docker run --rm vaultwarden/server:1.36.0-alpine /vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=
# Runtime default: closed. The setup overlay (docker-compose.setup.yml) opens
# signups for the FIRST `up` so you can register your account; the next plain
# `docker compose up -d` omits the overlay and closes them again. See README
# "First Vaultwarden account".
VAULTWARDEN_SIGNUPS_ALLOWED=false
