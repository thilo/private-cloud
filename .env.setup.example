###############################################################################
# Personal Cloud — SETUP-ONLY secrets (initial admin accounts)
#
# These create the first Immich + Seafile admin accounts during provisioning.
# They are NOT runtime secrets: Docker Compose does NOT load this file on a normal
# `up`. It is read only by:
#   - scripts/init.sh      (generates the real file with random passwords)
#   - scripts/bootstrap.sh (creates the Immich admin)
#   - scripts/verify.sh    (logs in as both admins for the acceptance tests)
#   - the FIRST `up`, via docker-compose.setup.yml, to seed the Seafile admin
#
# Used for both local and production: scripts/init.sh copies this template to
#   .env (local)        -> .env.setup
#   .env.production      -> .env.production.setup
# and fills the passwords. Real *.setup files are gitignored + chmod 600.
#
# Once your accounts exist, the secret of record is the account itself — store
# these credentials in Vaultwarden. You can keep this file for re-running
# verify.sh, or back it up separately and remove it from the box.
#
# Set the email(s) to your real address in production.
###############################################################################

# First Immich admin, created by scripts/bootstrap.sh (used by the iOS app). The
# admin-sign-up endpoint only creates this first admin and is rejected once it
# exists, so it needs no extra env flag to close.
IMMICH_ADMIN_EMAIL=admin@example.com
IMMICH_ADMIN_NAME=Admin
IMMICH_ADMIN_PASSWORD=CHANGEME

# First Seafile admin, seeded on Seafile's first start (used by the apps).
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=CHANGEME
