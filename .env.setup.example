###############################################################################
# Personal Cloud — SETUP-ONLY secret (initial Seafile admin account)
#
# This creates the first Seafile admin account during provisioning. It is NOT a
# runtime secret: Docker Compose does NOT load this file on a normal `up`. It is
# read only by:
#   - scripts/init.sh   (generates the real file with a random password)
#   - scripts/verify.sh (logs in as the Seafile admin for the acceptance test)
#   - the FIRST `up`, via docker-compose.setup.yml, to seed the Seafile admin
#
# Immich and Vaultwarden are NOT here: their first accounts are registered in the
# browser during setup (Immich's admin-sign-up is open until the first admin
# exists; Vaultwarden's signups are opened by the setup overlay). verify.sh reads
# the Immich admin password from the environment or prompts for it.
#
# Used for both local and production: scripts/init.sh copies this template to
#   .env (local)        -> .env.setup
#   .env.production      -> .env.production.setup
# and fills the password. Real *.setup files are gitignored + chmod 600.
#
# Once your account exists, the secret of record is the account itself — store
# these credentials in Vaultwarden. You can keep this file for re-running
# verify.sh, or back it up separately and remove it from the box.
#
# Set the email to your real address in production.
###############################################################################

# First Seafile admin, seeded on Seafile's first start (used by the apps).
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=CHANGEME
