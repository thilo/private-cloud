# Source this once per shell to point every command at PRODUCTION:
#
#   source scripts/prod.env
#   docker compose up -d          # day-to-day: base + production overlay, runtime env
#   docker compose ps
#   ./scripts/bootstrap.sh        # creates the Immich admin
#   ./scripts/verify.sh           # acceptance tests
#
# COMPOSE_FILE  -> base + production overlay (binds fast volumes to the attached
#                  volume; the Storage Box CIFS volumes come from the base file).
# COMPOSE_ENV_FILES / ENV_FILE -> RUNTIME secrets live at /root/.env.production
#                  (outside the deploy dir) so rsync updates never touch or expose
#                  them. The SETUP-only admin secrets live in a SEPARATE file,
#                  /root/.env.production.setup, which is NOT loaded at runtime;
#                  bootstrap.sh / verify.sh derive it automatically as ${ENV_FILE}.setup.
#
# FIRST 'up' only — add the setup overlay + setup env file to seed the Seafile admin:
#   docker compose -f docker-compose.yml -f docker-compose.production.yml \
#     -f docker-compose.setup.yml \
#     --env-file /root/.env.production --env-file /root/.env.production.setup up -d
export COMPOSE_FILE="docker-compose.yml:docker-compose.production.yml"
export COMPOSE_ENV_FILES="/root/.env.production"
export ENV_FILE="/root/.env.production"
