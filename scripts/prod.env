# Source this once per shell to point every command at PRODUCTION:
#
#   source scripts/prod.env
#   docker compose up -d          # base + production overlay, /root/.env.production
#   docker compose ps
#   ./scripts/bootstrap.sh        # creates the Immich admin
#   ./scripts/verify.sh           # acceptance tests
#
# COMPOSE_FILE  -> base + production overlay (binds fast volumes to the attached
#                  volume; the Storage Box CIFS volumes come from the base file).
# COMPOSE_ENV_FILES / ENV_FILE -> secrets live at /root/.env.production (outside
#                  the deploy dir) so rsync updates never touch or expose them.
export COMPOSE_FILE="docker-compose.yml:docker-compose.production.yml"
export COMPOSE_ENV_FILES="/root/.env.production"
export ENV_FILE="/root/.env.production"
