[Unit]
Description=private-cloud backup to the Storage Box
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# No-op unless SMTP_HOST + ALERT_EMAIL are set.
OnFailure=pc-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/private-cloud
# ENV_FILE is read by backup.sh; prod.env's exports are not needed for a dump.
Environment=ENV_FILE=/root/.env.production
ExecStart=/opt/private-cloud/scripts/backup.sh
# Type=oneshot has no start timeout by default; a wedged CIFS mount would hang
# the unit forever.
TimeoutStartSec=1800
